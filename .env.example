# ── Required in production ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Environment ───────────────────────────────────────────────────────────
# Set to "production" to enable HTTPS-only cookies and strict key validation
FLASK_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
DB_PATH=/data/calencraft.db

# ── App version (controls which DB migrations run) ────────────────────────
APP_VERSION=1

# ── Feed cache TTL in seconds (default: 300 = 5 minutes) ─────────────────
# Set to 0 to disable caching
FEED_CACHE_TTL=300